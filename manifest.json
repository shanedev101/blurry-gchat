{
  "manifest_version": 3,
  "name": "Blurry GChat",
  "version": "1.0.0",
  "description": "Privacy shield for GChat — blur names, previews, avatars, and more.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabCapture"],
  "host_permissions": ["https://chat.google.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.google.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "toggle-privacy": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Cycle names privacy mode"
    }
  }
}
