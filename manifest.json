{
  "manifest_version": 3,
  "name": "Shroudly",
  "version": "1.0.1",
  "description": "Blur & hide for Google Chat - protect names, previews & avatars from shoulder-surfing.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabCapture", "sidePanel"],
  "host_permissions": ["https://chat.google.com/*"],
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.google.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ]
}
