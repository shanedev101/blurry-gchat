{
  "name": "blurry-gchat",
  "version": "1.0.0",
  "description": "Privacy shield for GChat — blur names, previews, avatars, and more.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "pack": "node scripts/pack.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/**/*.js\" \"popup.html\" \"*.json\" \"*.md\""
  },
  "keywords": [
    "chrome-extension",
    "google-chat",
    "privacy",
    "obfuscation"
  ],
  "author": "ShaneDev101",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "bestzip": "^2.2.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-static-copy": "^1.0.5"
  }
}
