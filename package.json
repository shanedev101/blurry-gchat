{
  "name": "shroudly",
  "version": "1.1.0",
  "description": "Blur & hide for Google Chat - protect names, previews & avatars from shoulder-surfing.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && node scripts/build.js",
    "pack": "node scripts/pack.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/**/*.js\" \"popup.html\" \"*.json\" \"*.md\""
  },
  "keywords": [
    "chrome-extension",
    "google-chat",
    "privacy",
    "obfuscation"
  ],
  "author": "shanedev101",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "bestzip": "^2.2.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vite": "^8.0.0",
    "vite-plugin-static-copy": "^3.0.0",
    "vitest": "^3.2.6"
  }
}
